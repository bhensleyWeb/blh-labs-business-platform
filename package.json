{
  "name": "blh-labs-business-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --configLoader runner",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.build-server.json && vite build --configLoader runner && node scripts/deploy-website.mjs",
    "deploy:website": "npm run build",
    "start": "node dist-server/index.js",
    "test": "node --test --experimental-strip-types server/store.test.ts",
    "check": "npm run test && npm run build",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "googleapis": "^190.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
